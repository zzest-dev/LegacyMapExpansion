<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><OutputType>Exe</OutputType><LangVersion>latest</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\MadOut2_BigCityOnline</GameDir>
    <ManagedDir>$(GameDir)\game_Data\Managed</ManagedDir><NoWarn>0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AdmissionTests.cs" /><Compile Include="../src/MapNetworkProtocol.cs" Link="MapNetworkProtocol.cs" /><Compile Include="../src/MapNetworkMessages.cs" Link="MapNetworkMessages.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(ManagedDir)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
